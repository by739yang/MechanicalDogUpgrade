# Local secrets
config.py
config.local.py
secrets.h
wifi_config.h
.env

# Python cache
__pycache__/
*.py[cod]

# Build and IDE output
.pio/
build/
*.bin
*.elf
*.map

# IDE configs that embed absolute toolchain paths -> keep local only.
# NOTE: patterns with a slash in the MIDDLE are anchored to this .gitignore's
# directory, so a bare ".vscode/..." would never match "firmware/.vscode/...".
# The leading "**/" is what makes them match at any depth.
**/.vscode/.browse
**/.vscode/c_cpp_properties.json
**/.vscode/launch.json
**/.vscode/*.log

# Diagnostic output regenerated on every run
diagnostics/boot_log.txt

# Host golden-test build output
tools/golden/build/

# Local backups and test artifacts
_board_backup_*/
_local_backup_*/
test/
*.log

# PlatformIO / ESP-IDF generated
sdkconfig
sdkconfig.old
sdkconfig.esp32dev
dependencies.lock
managed_components/